# Settings for robot-ops.sh on the robot laptop. Fill in the ports and cameras after `./robot-ops.sh ports` / `cameras`.
# Prefer the stable /dev/serial/by-id and /dev/v4l/by-id paths: /dev/ttyACM0 and /dev/video0 can swap on replug.

FOLLOWER_PORT=/dev/serial/by-id/CHANGE_ME     # follower arm (the one that moves the cube)
LEADER_PORT=/dev/serial/by-id/CHANGE_ME       # leader arm (the one you move by hand)
FOLLOWER_ID=follower_1                        # calibration ids: keep them the same for calibrate, record and eval
LEADER_ID=leader_1

FRONT_CAM=/dev/v4l/by-id/CHANGE_ME            # fixed camera ~0.80 m in front of the base, 0.42 m up, looking at the workspace
WRIST_CAM=/dev/v4l/by-id/CHANGE_ME            # camera on the gripper, looking down the jaws
CAM_W=640                                     # must match the sim: 640x480 @ 30 fps, keys front + wrist
CAM_H=480
CAM_FPS=30

TASK="pick up the red block and place it on the green pad"   # identical in sim, teleop and eval
DATASET_NAME=group31/so101_real_teleop
DATASET_ROOT=$HOME/so101_data/so101_real_teleop
EPISODE_TIME_S=25
RESET_TIME_S=10
MAX_REAL_EPISODES=50                          # challenge rule: at most 50 real episodes

VM=ubuntu@REDACTED_VM_IP                         # so101-gpu; datasets go to ~/work/datasets/real/ there
LEROBOT_VERSION=0.6.1
VENV=$HOME/.venvs/lerobot
